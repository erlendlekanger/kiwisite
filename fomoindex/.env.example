# Postgres (Neon, Supabase or Vercel Postgres). Tables are created on first use.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 32 random bytes as hex. Encrypts the private keys of the index wallets. Losing it loses the funds.
MASTER_KEY=
# Random string, signs login sessions.
SESSION_SECRET=
# Random string, protects the cron endpoints (send as ?key= or Authorization: Bearer).
CRON_SECRET=
# Random string, protects the admin endpoints.
ADMIN_KEY=
# Solana RPC. A Helius key is strongly recommended for speed and rate limits.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# fomo session for syncing the leaderboard (bearer token or cookie, whichever your session uses).
FOMO_API_TOKEN=
FOMO_COOKIE=
# Trading rules
MIN_LIQUIDITY_USD=50000
MIN_WEIGHT_PCT=2
REBALANCE_THRESHOLD_PCT=2.5
MAX_SLIPPAGE_BPS=150
MAX_TOKENS_PER_INDEX=12
